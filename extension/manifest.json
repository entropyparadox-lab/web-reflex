{
  "manifest_version": 3,
  "name": "WebReflex SidePanel",
  "version": "0.1.0",
  "description": "Deterministic, instant action cache controller for AI web agents",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:9199/*",
    "http://localhost:9199/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open WebReflex SidePanel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
